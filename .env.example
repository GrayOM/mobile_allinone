# Local server
MSW_HOST=127.0.0.1
MSW_PORT=8765
MSW_LAN_ACCESS=false
# LAN 실행 시에만 프로세스마다 32자 이상의 임시 토큰을 설정합니다.
MSW_API_TOKEN=
MSW_ADMIN_TOKEN=
MSW_TRUSTED_HOSTS=
MSW_ENABLE_API_DOCS=false
MSW_DEFAULT_MOCK_MODE=false
MSW_AUTO_OPEN_BROWSER=true
MSW_MASK_EXTERNAL_AI_DATA=true
MSW_STORE_AI_RAW_RESPONSES=false
MSW_PROXY_LISTEN_HOST=127.0.0.1
MOBSF_URL=
MOBSF_API_KEY=
MSW_MOBSF_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
MSW_MOBSF_ALLOWED_HOSTS=
# MSW_SEMGREP_RULES_PATH=C:\Tools\semgrep-rules-android-security\rules

# Store secrets only in your local .env/environment. Never commit real keys.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional
# MSW_CONFIG=C:\path\to\config.yaml
# MSW_DATA_DIR=C:\path\to\workbench-data
