# Local server
MSW_HOST=127.0.0.1
MSW_PORT=8765
MSW_DEFAULT_MOCK_MODE=true
MSW_AUTO_OPEN_BROWSER=true
MSW_MASK_EXTERNAL_AI_DATA=true
MOBSF_URL=
MOBSF_API_KEY=
# MSW_SEMGREP_RULES_PATH=C:\Tools\semgrep-rules-android-security\rules

# Store secrets only in your local .env/environment. Never commit real keys.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional
# MSW_CONFIG=C:\path\to\config.yaml
# MSW_DATA_DIR=C:\path\to\workbench-data
